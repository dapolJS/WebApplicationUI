@page "/notes"
@inject HttpClient Http
@using System.Text.Json
@using BlazorApp1.Models
@rendermode InteractiveServer

@*
    Login
    who created note
    create archive for done notes
    status change from true false to DONE TO-DO
    refactor from notebook to category
    create new column and in endpoint Type : TO DO or TO BUY
    create categories
    filter by Categories and by Type
*@
<PageTitle>Notes</PageTitle>

<h1>Notes</h1>

<p>
    Total count of notes : @(_notes?.Count ?? 0)
</p>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p style="color:red;">@_errorMessage</p>
}

<!-- New Note Form -->
<div style="margin-bottom: 1em;">
    <input placeholder="Title..." @bind="newNote.Title"/>
    <input placeholder="Description..." @bind="newNote.Description"/>
    <button @onclick="CreateNewNote">Create</button>
</div>


@if (_notes == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th aria-label="Description of note">Description</th>
            <th aria-label="Status of note">Status</th>
            <th aria-label="Name of notebook">Notebook Name</th>
            <th>
    <span @onclick="ToggleSortByDate" style="cursor:pointer; user-select:none;">
        Date
        @(_isDateDescending ? " 🔽" : " 🔼")
    </span>
            </th>
        </tr>
        </thead>
        <tbody>
        @foreach (var note in _notes)
        {
            <tr class="@(_deletingNoteIds.Contains(note.Id) ? "fade-out" : (_newlyCreatedNoteIds.Contains(note.Id) ? "fade-in" : ""))">
                <td>@note.Title</td>
                <td>@note.Description</td>
                <td>@note.Done</td>
                <td>@note.Notebook?.Title</td>
                <td>@note.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>
                    <button @onclick="() => MarkAsDone(note.Id)" style="cursor:pointer; user-select:none;">Done
                    </button>
                </td>
                <td>
                    <button @onclick="() => DeleteNote(note.Id)" style="cursor:pointer; user-select:none;">Delete
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<Note>? _notes;

    private bool _isDateDescending = true;

    private string? _errorMessage;

    private HashSet<int> _newlyCreatedNoteIds = new();

    private HashSet<int> _deletingNoteIds = new();

    private Note newNote = new Note
    {
        NotebookId = null,
        Done = false
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);

        try
        {
            _notes = (await Http.GetFromJsonAsync<Note[]>("api/GetNotes/0/None"))?.ToList();
            SortNotesByDate();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching notes: {ex.Message}");
            _notes = [];
        }
    }

    private async Task CreateNewNote()
    {
        if (string.IsNullOrEmpty(newNote.Title) ||
            string.IsNullOrEmpty(newNote.Description)
           )
        {
            _errorMessage = "Please enter both a title and a description.";
            return;
        }

        _errorMessage = null;

        var response = await Http.PostAsJsonAsync("api/CreateNote", newNote);

        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("Clicked create note successfully!");
            var createdNote = await response.Content.ReadFromJsonAsync<Note>();
            if (createdNote != null)
            {
                _newlyCreatedNoteIds.Add(createdNote.Id);
                _notes.Add(createdNote);
                SortNotesByDate();

                StateHasChanged();

                await Task.Delay(500);

                _newlyCreatedNoteIds.Remove(createdNote.Id);
                StateHasChanged();
                
                newNote = new Note { NotebookId = null, Done = false };

            }
        }
        else
        {
            throw new Exception("Failed to create note!" + response.StatusCode + " " + response.Content);
        }
    }

    private async Task DeleteNote(int noteId)
    {
        Console.WriteLine("Deleted : " + noteId);

        _deletingNoteIds.Add(noteId);
        StateHasChanged();

        await Task.Delay(500);

        var response = await Http.DeleteAsync($"api/DeleteNote/{noteId}");
        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("Note deleted successfully!");

            var noteToRemove = _notes?.FirstOrDefault(x => x.Id == noteId);
            _notes!.Remove(noteToRemove);

            StateHasChanged();
        }
        else
        {
            Console.WriteLine("Failed to delete Note : " + response.StatusCode, response.Content, noteId);
        }

        _deletingNoteIds.Remove(noteId);
        StateHasChanged();
    }

    private async Task MarkAsDone(int noteId)
    {
        var noteToUpdate = new Note
        {
            Done = true
        };
        var response = (await Http.PutAsJsonAsync($"api/EditNote/{noteId}", noteToUpdate));

        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("Note updated successfully!");

            var updatedNote = await response.Content.ReadFromJsonAsync<Note>();
            var jsonUpdatedNote = JsonSerializer.Serialize<Note>(updatedNote);
            Console.WriteLine("reading updated note : " + jsonUpdatedNote);

            var note = _notes?.FirstOrDefault(x => x.Id == noteId);
            if (note != null && updatedNote != null)
            {
                note.Done = updatedNote.Done;
                StateHasChanged();
            }
        }
        else
        {
            Console.WriteLine($"Failed to update Note : {response.StatusCode}, {response.Content}, {noteId}");
        }
    }

    private void ToggleSortByDate()
    {
        Console.WriteLine("Toggle sort clicked");
        _isDateDescending = !_isDateDescending;
        SortNotesByDate();
    }

    private void SortNotesByDate()
    {
        if (_notes == null) return;

        var sortedNotes = _notes.OrderBy(n => n.Date).ToList();
        if (_isDateDescending)
        {
            sortedNotes.Reverse();
        }

        _notes = new List<Note>(sortedNotes);
    }

}